          "minimum": 0,
          "maximum": 100
        },
        "feedback": {
          "type": "string"
        },
        "studentMermaid": {
          "type": "string"
        },
        "nodes": {
          "type": "array"
        },
        "comparison": {
          "type": "object"
        }
      },
      "required": [
        "score",
        "feedback",
        "studentMermaid",
        "nodes",
        "comparison"
      ],
      "additionalProperties": false
    }
  }
}
